MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=eagle3-olmo2

# All writable pipeline data goes outside the repository.
EAGLE3_DATA_DIR=/mnt/ml-data/eagle3/data
EAGLE3_OUTPUT_DIR=/mnt/ml-data/eagle3/outputs/olmo2_1b_eagle3
EAGLE3_CACHE_DIR=/mnt/ml-data/eagle3/cache

# Model downloads, temporary files, and GPU compiler caches.
HF_HOME=/mnt/ml-data/huggingface
TMPDIR=/mnt/ml-data/tmp
XDG_CACHE_HOME=/mnt/ml-data/cache/xdg
CUDA_CACHE_PATH=/mnt/ml-data/cache/cuda
TORCHINDUCTOR_CACHE_DIR=/mnt/ml-data/cache/torchinductor
PYTHONDONTWRITEBYTECODE=1

# Machine-local DVC object cache and local object storage.
DVC_CACHE_DIR=/mnt/ml-data/dvc/cache
DVC_REMOTE_DIR=/mnt/ml-data/dvc/storage
